{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FFmpeg Workbench",
  "version": "0.1.0",
  "identifier": "local.ffmpeg.workbench",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FFmpeg Workbench",
        "width": 1440,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 720,
        "backgroundColor": "#f6f5f2"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; media-src 'self' blob: http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
